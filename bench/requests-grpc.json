      "weight": 60,
      "method": "POST",
      "host": "shop.bench.internal",
      "target": "/bench.shop.v1.Orders/GetOrder",
      "headers": [
        ["content-type", "application/grpc"],
        ["te", "trailers"],
        ["user-agent", "grpc-java-netty/1.85.1"],
        ["grpc-accept-encoding", "gzip"],
        ["authorization", "Bearer eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJzdG9yZWZyb250IiwiYXVkIjoib3JkZXJzIiwiZXhwIjoxOTI0OTkyMDAwfQ.bm90LWEtcmVhbC1zaWduYXR1cmUtYmVuY2htYXJrLW9ubHk"],
        ["traceparent", "00-4bf92f3577b34da6a3ce929d0e0e4736-5fb6b8c4d2a1e370-01"],
        ["baggage", "tenant=acme-eu,smock-session=bench-grpc-get-order,deployment=perf"]
      ],
      "body": null,
      "bodyFile": "requests-grpc/get-order.grpc",
      "expect": { "session": "bench-grpc-get-order", "status": 200, "grpcStatus": "OK", "mock": "shop", "stub": "get-order-partner-gold", "viaDefault": false }
